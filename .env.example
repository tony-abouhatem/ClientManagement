# Copy to .env to override the dev defaults used by application.yaml and docker-compose.yml.
# All values below are the defaults; none of them is a real secret.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/clientmanagement
DB_NAME=clientmanagement
DB_USERNAME=clientmanagement
DB_PASSWORD=clientmanagement

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_CONFIRM_TIMEOUT=5s

# Keycloak / JWT validation
ISSUER_URI=http://localhost:8081/realms/client-management
JWK_SET_URI=http://localhost:8081/realms/client-management/protocol/openid-connect/certs
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# App
SERVER_PORT=8080
PAGINATION_DEFAULT_PAGE=0
PAGINATION_DEFAULT_SIZE=20

# Score (WireMock)
SCORE_BASE_URL=http://localhost:8089
SCORE_CONNECT_TIMEOUT=1s
SCORE_READ_TIMEOUT=2s
SCORE_RETRY_MAX_ATTEMPTS=2
SCORE_RETRY_WAIT_DURATION=200ms
SCORE_RETRY_BACKOFF_MULTIPLIER=2
SCORE_CB_SLIDING_WINDOW_SIZE=10
SCORE_CB_FAILURE_RATE_THRESHOLD=50
SCORE_CB_WAIT_DURATION_IN_OPEN_STATE=10s

# Outbox
OUTBOX_RELAY_INTERVAL=5s
OUTBOX_BATCH_SIZE=100
OUTBOX_RETRY_WAIT_DURATION=1s
OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
OUTBOX_RETRY_MAX_WAIT_DURATION=15s
OUTBOX_RETRY_MAX_ATTEMPTS=5760

# CUSTOMER_STATUS_CHANGE consumer retry (3 attempts in total = 1 + max retries)
STATUS_CHANGE_RETRY_MAX_RETRIES=2
STATUS_CHANGE_RETRY_INITIAL_INTERVAL=1s
STATUS_CHANGE_RETRY_MULTIPLIER=2
STATUS_CHANGE_RETRY_MAX_INTERVAL=10s
