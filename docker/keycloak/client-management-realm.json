{
  "realm": "client-management",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Read access to customers and scores" },
      { "name": "ADMIN", "description": "Create, update and delete customers" }
    ]
  },
  "clients": [
    {
      "clientId": "client-management-cli",
      "name": "ClientManagement CLI / Postman",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "email": "user@client-management.local",
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "user", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@client-management.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
