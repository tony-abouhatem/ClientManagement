            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Republish the same eventId (duplicate) - routed",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same guard as the first publish: no customer, no event.",
                  "if (!pm.collectionVariables.get('statusChangeTarget')) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same eventId, but the status from before the change: if the duplicate were applied, the status would visibly revert.",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('routed to the status-change queue', () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"properties\":{\"content_type\":\"application/json\"},\"routing_key\":\"customer.status.change\",\"payload\":\"{\\\"eventId\\\":\\\"{{statusChangeEventId}}\\\",\\\"eventType\\\":\\\"CUSTOMER_STATUS_CHANGE\\\",\\\"customerId\\\":{{customerId}},\\\"status\\\":\\\"{{statusBefore}}\\\"}\",\"payload_encoding\":\"string\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rabbitUrl}}/api/exchanges/%2F/customer.events/publish",
              "host": ["{{rabbitUrl}}"],
              "path": ["api", "exchanges", "%2F", "customer.events", "publish"]
            }
          }
        },
        {
          "name": "Get customer after the duplicate event (USER) - 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the consumer time to receive (and skip) the duplicate before reading the customer.",
                  "const DUPLICATE_WAIT_MS = 2000;",
                  "setTimeout(() => {}, DUPLICATE_WAIT_MS);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('duplicate eventId ignored: status and version unchanged', () => {",
                  "  pm.expect(json.status).to.eql(pm.collectionVariables.get('statusChangeTarget'));",
                  "  pm.expect(json.version).to.eql(Number(pm.collectionVariables.get('customerVersion')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        }
