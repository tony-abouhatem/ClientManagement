        {
          "name": "Create customer (ADMIN) - 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A valid CPF that is new on every run, so the collection can be run repeatedly.",
                  "function checkDigit(digits) {",
                  "  const firstWeight = digits.length + 1;",
                  "  const sum = digits.reduce((total, digit, index) => total + digit * (firstWeight - index), 0);",
                  "  const rest = (sum * 10) % 11;",
                  "  return rest === 10 ? 0 : rest;",
                  "}",
                  "let base;",
                  "do {",
                  "  base = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "} while (new Set(base).size === 1);",
                  "const first = checkDigit(base);",
                  "const second = checkDigit([...base, first]);",
                  "pm.collectionVariables.set('customerCpf', [...base, first, second].join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('stores the CPF as digits, ACTIVE, version 0', () => {",
                  "  pm.expect(json.cpf).to.eql(pm.collectionVariables.get('customerCpf'));",
                  "  pm.expect(json.status).to.eql('ACTIVE');",
                  "  pm.expect(json.version).to.eql(0);",
                  "});",
                  "pm.test('Location points to the customer', () => pm.response.to.have.header('Location', '/customers/' + json.id));",
                  "pm.collectionVariables.set('customerId', json.id);",
                  "pm.collectionVariables.set('customerVersion', json.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Cliente Postman\",\"cpf\":\"{{customerCpf}}\",\"email\":\"cliente.postman@example.com\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
