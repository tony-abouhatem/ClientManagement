    {
      "name": "RabbitMQ",
      "description": "Checks the messaging side through the RabbitMQ management HTTP API (basic auth {{rabbitUser}}/{{rabbitPassword}}): the CUSTOMER_CREATED event of the main customer, and a CUSTOMER_STATUS_CHANGE that is applied once and ignored when its eventId comes again.",
      "item": [
        {
          "name": "Read CUSTOMER_CREATED from the customer.created queue - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ack_requeue_true puts every message back, so other people's messages stay in the queue.",
                  "// The queue has no consumer: it holds up to MESSAGES_READ messages from earlier runs and manual use.",
                  "const MESSAGES_READ = 1000;",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const messages = pm.response.json();",
                  "const customerId = Number(pm.collectionVariables.get('customerId'));",
                  "function parsePayload(message) {",
                  "  try { return JSON.parse(message.payload); } catch (error) { return {}; }",
                  "}",
                  "const event = messages.map(parsePayload)",
                  "  .find(payload => payload.eventType === 'CUSTOMER_CREATED' && payload.customerId === customerId);",
                  "pm.test('a CUSTOMER_CREATED event names the created customer', () => {",
                  "  const hint = messages.length >= MESSAGES_READ",
                  "    ? ' (the queue holds ' + MESSAGES_READ + '+ messages; purge customer.created and run again)' : '';",
                  "  pm.expect(event, 'CUSTOMER_CREATED for customer ' + customerId + hint).to.not.equal(undefined);",
                  "  pm.expect(event.eventId).to.match(/^[0-9a-f-]{36}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"count\":1000,\"ackmode\":\"ack_requeue_true\",\"encoding\":\"auto\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rabbitUrl}}/api/queues/%2F/customer.created/get",
              "host": ["{{rabbitUrl}}"],
              "path": ["api", "queues", "%2F", "customer.created", "get"]
            }
          }
        },
        {
          "name": "Get customer before the status change (USER) - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const found = pm.response.code === 200;",
                  "pm.collectionVariables.set('statusBefore', found ? json.status : '');",
                  "pm.collectionVariables.set('versionBefore', found ? json.version : '');",
                  "// Empty when the customer is missing, so the publish requests below are skipped (see their pre-request).",
                  "pm.collectionVariables.set('statusChangeTarget', found ? (json.status === 'ACTIVE' ? 'INACTIVE' : 'ACTIVE') : '');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Publish CUSTOMER_STATUS_CHANGE - routed",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Without a customer the event would be a poison message left in the DLQ; earlier failures already fail the run.",
                  "if (!pm.collectionVariables.get('statusChangeTarget')) {",
                  "  pm.execution.skipRequest();",
                  "}",
                  "pm.collectionVariables.set('statusChangeEventId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('statusPollAttempt', 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('routed to the status-change queue', () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"properties\":{\"content_type\":\"application/json\"},\"routing_key\":\"customer.status.change\",\"payload\":\"{\\\"eventId\\\":\\\"{{statusChangeEventId}}\\\",\\\"eventType\\\":\\\"CUSTOMER_STATUS_CHANGE\\\",\\\"customerId\\\":{{customerId}},\\\"status\\\":\\\"{{statusChangeTarget}}\\\"}\",\"payload_encoding\":\"string\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{rabbitUrl}}/api/exchanges/%2F/customer.events/publish",
              "host": ["{{rabbitUrl}}"],
              "path": ["api", "exchanges", "%2F", "customer.events", "publish"]
            }
          }
        },
        {
          "name": "Get customer after the status change (USER) - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The consumer is asynchronous: re-run this request every POLL_INTERVAL_MS, at most MAX_POLLS times.",
                  "const MAX_POLLS = 10;",
                  "const POLL_INTERVAL_MS = 500;",
                  "const json = pm.response.json();",
                  "const expectedStatus = pm.collectionVariables.get('statusChangeTarget');",
                  "const poll = Number(pm.collectionVariables.get('statusPollAttempt'));",
                  "if (json.status !== expectedStatus && poll < MAX_POLLS) {",
                  "  pm.collectionVariables.set('statusPollAttempt', poll + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestId);",
                  "  setTimeout(() => {}, POLL_INTERVAL_MS);",
                  "} else {",
                  "  pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "  pm.test('status changed by the event and version incremented', () => {",
                  "    pm.expect(json.status).to.eql(expectedStatus);",
                  "    pm.expect(json.version).to.eql(Number(pm.collectionVariables.get('versionBefore')) + 1);",
                  "  });",
                  "  pm.collectionVariables.set('customerVersion', json.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
